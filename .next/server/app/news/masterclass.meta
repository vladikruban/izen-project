{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/news/layout,_N_T_/news/masterclass/layout,_N_T_/news/masterclass/page,_N_T_/news/masterclass"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/news/masterclass/__PAGE__",
    "/news/masterclass",
    "/news",
    "/_index",
    "/_head"
  ]
}